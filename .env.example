NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres (docker-compose)
DATABASE_URL=postgres://lab:lab@localhost:5432/lab

# Redis (idempotência e cache)
REDIS_URL=redis://localhost:6379

# Kafka (docker-compose)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=merchant-support-lab
KAFKA_GROUP_ID=merchant-support-lab-orders
KAFKA_TOPIC_ORDERS=lab.orders.v1
KAFKA_TOPIC_ORDERS_DLQ=lab.orders.v1.dlq

# SQS (LocalStack)
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/lab-messages
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# LLM: "fake" roda sem chave. Para o real: LLM_PROVIDER=anthropic e a chave abaixo.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
EMBEDDING_DIM=256

# Segredo do webhook (HMAC). Valor de exemplo, nunca use em produção.
WEBHOOK_SECRET=troque-me

# OpenTelemetry (Jaeger do docker-compose). Vazio desliga.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
